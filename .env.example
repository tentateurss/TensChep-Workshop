# Copy to .env and edit. Every setting is optional except the domain and the contact.

# Public domain for HTTPS (Caddy requests the certificate for it; point its DNS A record at the server first)
POECRAFT_DOMAIN=craft.example.org

# Contact put in the User-Agent of every outgoing request (poe.ninja, pathofexile.com, RePoE, OCR.space).
# GGG asks API users to identify themselves - use the operator's address or a project URL.
POECRAFT_CONTACT=you@example.org

# Pin the league for prices and trade links (default: the current challenge league, found automatically)
#POECRAFT_LEAGUE=Allflame

# Screenshot OCR (beta): your OCR.space API key. Unset = screenshots are never sent anywhere.
#POECRAFT_OCR_SPACE_KEY=

# Front end on another origin? List it here (comma-separated) to allow cross-origin API calls.
#POECRAFT_CORS_ORIGINS=https://my-frontend.example.org

# Limits (defaults shown). Rates are "requests per second/burst" per client IP.
#POECRAFT_RATE_API=10/20
#POECRAFT_RATE_PLAN=0.2/3
#POECRAFT_RATE_TRADE=1/5
#POECRAFT_RATE_OCR=0.02/3
#POECRAFT_MAX_SIMS=20000
#POECRAFT_MAX_BODY=2097152
#POECRAFT_MAX_CONNECTIONS=64
#POECRAFT_PLAN_QUEUE_WAIT=60
#POECRAFT_TRADE_CACHE_TTL=300
#POECRAFT_TRADE_MAX_PER_10S=3
#POECRAFT_PRICE_REFRESH_MIN=30
